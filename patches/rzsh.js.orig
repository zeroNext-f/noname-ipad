  localStorage.setItem("rzsh_remote_notice_id", noticeId);
  var overlay = document.createElement("div");
  overlay.style.cssText = "position:fixed;left:0;top:0;width:100%;height:100%;z-index:10000;background:rgba(0,0,0,.65);display:flex;align-items:center;justify-content:center;";
  var box = document.createElement("div");
  box.style.cssText = "width:72%;max-height:72%;overflow:auto;background:rgba(26,24,38,.96);color:#eadfcb;border:1px solid rgba(234,223,203,.35);border-radius:10px;padding:18px 20px;font-family:shousha,serif;font-size:18px;line-height:1.55;box-shadow:0 8px 24px rgba(0,0,0,.45);";
  var title = document.createElement("div");
  title.style.cssText = "font-size:24px;margin-bottom:12px;color:#f1d18a;";
  title.textContent = info.title || "更新公告";
  var body = document.createElement("div");
  body.innerHTML = lines.join("<br>");
  var close = document.createElement("div");
  close.style.cssText = "margin-top:16px;text-align:center;color:#9fd68a;font-size:16px;";
  close.textContent = "点击关闭";
  box.appendChild(title);
  box.appendChild(body);
  if (info.downloadUrl) {
    var link = document.createElement("div");
    link.style.cssText = "margin-top:12px;color:#9fc8ff;font-size:14px;word-break:break-all;";
    link.textContent = info.downloadUrl;
    box.appendChild(link);
  }
  box.appendChild(close);
  overlay.appendChild(box);
  overlay.addEventListener("click", function (e) {
    if (e.target === overlay || e.target === close) overlay.remove();
  });
  document.body.appendChild(overlay);
}
