  }
  if (info.version) li1mgmx0IJ = info.version;
}
function rzshShowRemoteNotice(info) {
  if (!info || typeof info != "object") return;
  var noticeId = info.noticeId || info.version || "remote";
  if (!info.forceNotice && localStorage.getItem("rzsh_remote_notice_id") == noticeId) return;
  var lines = Array.isArray(info.notice) ? info.notice : [];
