var rzshVideoBg = null;
function rzshCreateVideoBg(config) {
  if (!config || !config.name) return;
  if (rzshVideoBg && rzshVideoBg.parentNode) {
    try {
      rzshVideoBg.pause();
      rzshVideoBg.removeAttribute('src');
      rzshVideoBg.load();
    } catch (e) {}
    rzshVideoBg.parentNode.removeChild(rzshVideoBg);
    rzshVideoBg = null;
  }
  var video = document.createElement('video');
  video.src = li1mgmx0Ia + li1mgmx0IA + config.name;
  video.autoplay = config.autoplay !== false;
  video.loop = config.loop !== false;
  video.muted = config.muted !== false;
  video.defaultMuted = config.muted !== false;
  video.playsInline = true;
  video.setAttribute('playsinline', 'true');
  video.setAttribute('webkit-playsinline', 'true');
  video.setAttribute('x5-video-player-type', 'h5');
  video.setAttribute('x5-video-player-fullscreen', 'false');
  video.preload = 'auto';
  if (config.poster) video.poster = li1mgmx0Ia + li1mgmx0IA + config.poster;
  if (config.playbackRate) video.playbackRate = config.playbackRate;
  video.style.cssText = `
    position: fixed;
    left: 0;
    top: 0;
    width: 100vw;
    height: 100vh;
    object-fit: ${config.objectFit || 'cover'};
    z-index: 0;
    pointer-events: none;
    opacity: ${config.opacity == null ? 1 : config.opacity};
    background: black;
  `;
  document.body.style.position = document.body.style.position || 'relative';
  document.body.style.overflow = 'hidden';
  document.body.insertBefore(video, document.body.firstChild);
  var playPromise = video.play();
  if (playPromise && playPromise.catch) {
    playPromise.catch(function () {
      var playOnce = function () {
        video.play().catch(function () {});
        document.removeEventListener('click', playOnce);
        document.removeEventListener('touchstart', playOnce);
      };
      document.addEventListener('click', playOnce, { once: true });
      document.addEventListener('touchstart', playOnce, { once: true });
    });
  }
  rzshVideoBg = video;
}
function rzshDestroyVideoBg() {
  if (!rzshVideoBg) return;
  try {
    rzshVideoBg.pause();
    rzshVideoBg.removeAttribute('src');
    rzshVideoBg.load();
  } catch (e) {}
  if (rzshVideoBg.parentNode) rzshVideoBg.parentNode.removeChild(rzshVideoBg);
  rzshVideoBg = null;
}
